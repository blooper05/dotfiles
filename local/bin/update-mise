#!/bin/bash

set -ex

/opt/homebrew/bin/mise outdated --bump

/opt/homebrew/bin/mise plugins update
/opt/homebrew/bin/mise install
/opt/homebrew/bin/mise prune

rm -rf "$HOME/.agents/"
rm -rf "$HOME/.cargo/"
rm -rf "$HOME/.npm/"
rm -rf "$HOME/.rustup/"
rm -rf "$HOME/.serena/"
rm -rf "$HOME/.terraform.d/"

gh skill install atlassian/twg-cli --all '--agent=claude-code' '--scope=user' --allow-hidden-dirs --force
gh skill install upstash/context7 find-docs '--agent=claude-code' '--scope=user' --allow-hidden-dirs --force
